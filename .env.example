# ─── Fase 2: Verificação WhatsApp ────────────────────────────────────────────
# Passos para ativar:
# 1. Preencha as variáveis abaixo
# 2. Suba o Evolution API: docker compose --profile whatsapp up -d evolution
# 3. Acesse http://localhost:8080, crie uma instância e escaneie o QR code
# 4. Reinicie o backend: docker compose restart backend
#
# EVOLUTION_API_URL=http://evolution:8080
# EVOLUTION_API_KEY=prospector_evo_key
# EVOLUTION_INSTANCE=prospector
# WHATSAPP_CHECK_TIMEOUT_SECONDS=300
# WHATSAPP_TEST_MESSAGE=Olá! Tudo bem?

